{
  "name": "@wild-daily/generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/index.ts --back 60 --days 120 --out ../web/public/puzzles",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@wild-daily/core": "workspace:*",
    "@wild-daily/game-fresh-snow": "workspace:*",
    "@wild-daily/game-nests": "workspace:*",
    "@wild-daily/game-dawn-chorus": "workspace:*",
    "@wild-daily/game-stepping-stones": "workspace:*",
    "@wild-daily/game-mushroom-rings": "workspace:*",
    "@wild-daily/game-pack": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@types/node": "22.10.2"
  }
}