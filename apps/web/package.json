{
  "name": "@wild-daily/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "puzzles": "pnpm --filter @wild-daily/generator generate",
    "dev": "astro dev",
    "build": "pnpm run puzzles && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "astro": "7.4.7",
    "@astrojs/sitemap": "3.7.4",
    "@wild-daily/ui": "workspace:*",
    "@wild-daily/core": "workspace:*",
    "@wild-daily/game-fresh-snow": "workspace:*",
    "@wild-daily/game-dawn-chorus": "workspace:*",
    "@wild-daily/game-nests": "workspace:*",
    "@wild-daily/game-stepping-stones": "workspace:*",
    "@wild-daily/game-mushroom-rings": "workspace:*",
    "@wild-daily/game-pack": "workspace:*",
    "gsap": "3.15.1",
    "canvas-confetti": "1.9.4"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@types/canvas-confetti": "1.9.0"
  }
}