---
// Source of public/og.png, the social share image (dev only, noindex). Re-shoot at 1200×630 after art changes.
import Base from '../../layouts/Base.astro';
import { character, type CharacterId } from '@wild-daily/ui';
const cast: CharacterId[] = ['owl', 'squirrel', 'fox', 'rabbit', 'deer', 'moose'];
---
<Base title="Share image" description="Source of the Wild Daily share image." noindex>
  <div id="og" data-theme="light">
    <svg class="og-hills" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true"><path d="M0 120 L180 40 L360 110 L560 20 L760 100 L960 30 L1200 110 V260 H0Z" fill="#E4F1F9" /><path d="M0 180 C300 120 600 210 1200 150 V260 H0Z" fill="#FFFFFF" /></svg>
    <div class="og-text">
      <h1>Wild Daily</h1>
      <p>Short nature puzzles, new every day. Free to play.</p>
    </div>
    <div class="og-cast">{cast.map((a, i) => <Fragment set:html={character(a, i % 2 ? 'happy' : 'idle', i === 2 ? 190 : 140)} />)}</div>
  </div>
</Base>
<style>
  #og { position: fixed; inset: 0; z-index: 99; width: 1200px; height: 630px; overflow: hidden; background: linear-gradient(#BFE0F2, #A7D2EA 60%); }
  .og-hills { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 260px; }
  .og-text { position: absolute; left: 80px; top: 70px; color: #233142; }
  .og-text h1 { margin: 0; font-family: var(--font-display); font-size: 120px; line-height: 1; letter-spacing: -2px; }
  .og-text p { margin: 18px 0 0; font-size: 38px; font-weight: 800; max-width: 22ch; color: #233142; }
  .og-cast { position: absolute; left: 60px; right: 60px; bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; }
</style>
