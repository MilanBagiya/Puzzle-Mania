---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { bird, character, frog, mushroom, nest, svgUse } from '@wild-daily/ui';
const games = [
  { name: 'Fresh Snow', status: 'Daily', live: true, time: '1-12 min · 3 levels a day', blurb: 'Follow animal footprints through the snow and guide each one home.', art: character('fox', 'happy', 100, 'cheer'), href: '/fresh-snow', cta: 'Play' },
  { name: 'Trail Trek', status: '60 stages', live: true, time: 'Play any time', blurb: 'A Fresh Snow campaign in four chapters. Earn three paws on every stage.', art: character('rabbit', 'happy', 90, 'cheer') + character('deer', 'idle', 80), href: '/trek', cta: 'Open the map' },
  { name: 'Nests', status: 'Daily', live: true, time: '2-4 min', blurb: "Each tree's number is how many nests it can see along its row and column.", art: nest(90), href: '/nests', cta: 'Play' },
  { name: 'Dawn Chorus', status: 'Daily', live: true, time: '1-3 min', blurb: 'Read the clues and put five birds in the order they sang at sunrise.', art: bird('#E2594A', 84) + bird('#3F86D3', 70), href: '/dawn-chorus', cta: 'Play' },
  { name: 'Stepping Stones', status: 'Daily bonus', live: true, time: '1-4 min', blurb: 'Help the frog across the pond: each lily pad says exactly how far to jump.', art: frog(100), href: '/stepping-stones', cta: 'Play' },
  { name: 'Mushroom Rings', status: 'Daily bonus', live: true, time: 'About 1 min', blurb: 'Read a ring of mushrooms and find where the spore landed, in three guesses.', art: mushroom(70) + mushroom(90) + mushroom(70), href: '/mushroom-rings', cta: 'Play' },
  { name: 'Who Was Here?', status: 'Coming later', live: false, time: '6 guesses', blurb: 'Guess the animal from a close-up. Needs a library of original animal art first.', art: character('deer', 'idle', 90) },
  { name: 'Sandy Shores', status: 'Summer season', live: false, time: '1-12 min', blurb: 'Fresh Snow on the beach, with a crab that always steps sideways.', art: svgUse('n-crab', '0 0 80 64', 100) },
];
---
<Base title="All games" description="Every Wild Daily puzzle: Fresh Snow, Trail Trek, Nests, Dawn Chorus, Stepping Stones and Mushroom Rings." active="games">
  <PageHead title="All games" lead="Six games from one forest, with new puzzles every day." />
  <main class="wrap body">
    <div class="grid3 gap-s5">
      {games.map((g) => (
        <article class="card stack">
          <span class="stage" style="height:130px" set:html={g.art} />
          <div class="row gap-s2" style="justify-content:space-between"><h2 class="h-m">{g.name}</h2><span class:list={['pill', g.live ? 'p-g' : 'p-y']}>{g.status}</span></div>
          <p style="margin:0" class="muted">{g.blurb}</p>
          <div class="row gap-s2" style="justify-content:space-between; margin-top:auto"><span style="font-weight:800; font-size:14px">{g.time}</span>{g.live && <a class="btn btn-p" href={g.href}>{g.cta}</a>}</div>
        </article>
      ))}
    </div>
  </main>
</Base>