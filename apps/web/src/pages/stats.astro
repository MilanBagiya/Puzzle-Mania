---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Your stats and badges" description="Your streaks, best times, Trail Trek progress and badges." active="stats" noindex>
  <PageHead title="Your stats" />
  <main class="wrap body">
    <div class="statrow">
      <div class="card stack" style="background:var(--fox-t); gap:4px"><b class="big" id="s-cur">0</b><span style="font-weight:800; font-size:14px">day streak</span></div>
      <div class="card stack" style="background:var(--rabbit-t); gap:4px"><b class="big" id="s-best">0</b><span style="font-weight:800; font-size:14px">best streak</span></div>
      <div class="card stack" style="background:var(--deer-t); gap:4px"><b class="big" id="s-trek-n">0</b><span style="font-weight:800; font-size:14px">Trek stages</span></div>
    </div>
    <p class="muted" id="s-trek" style="margin:12px 0 0"></p>
    <p class="muted" id="s-snow" style="margin-top:16px"></p>
    <section class="section card stack"><h2 class="h-m">By game</h2>
      <div style="overflow-x:auto"><table style="width:100%; border-collapse:collapse; font-size:15px">
        <thead><tr style="text-align:left"><th scope="col" style="padding:10px 12px">Game</th><th scope="col" style="padding:10px 12px">Solved</th><th scope="col" style="padding:10px 12px">Best time</th><th scope="col" class="hide-sm" style="padding:10px 12px">Average</th><th scope="col" style="padding:10px 12px">3 paws</th></tr></thead>
        <tbody id="s-table"></tbody></table></div>
      <p class="muted" style="margin:0; font-size:14px">Games from the pack appear here after you play them.</p>
    </section>
    <section class="section stack"><div class="row" style="justify-content:space-between"><h2 class="h-m">Badges</h2><span class="pill p-y" id="s-badge-count"></span></div><div class="grid4" id="s-badges"></div></section>
  </main>
  <script>import '../scripts/stats.ts';</script>
</Base>
