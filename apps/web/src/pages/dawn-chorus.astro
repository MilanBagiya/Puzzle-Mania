---
import Base from '../layouts/Base.astro';
import { activeFor } from '../data/catalog';
import GameHead from '../components/GameHead.astro';
import HelpDialog from '../components/HelpDialog.astro';
---
<Base title="Dawn Chorus: daily bird puzzle" description="Five birds sang at sunrise. Read the clues and work out the order. A new puzzle every day." active={activeFor('dawn')}>
  <main class="wrap" style="padding-top:18px">
    <GameHead title="Dawn Chorus" prefix="dc" />
    <div class="game">
      <div class="stack">
        <div class="card stack"><h2 class="h-s">Five birds sang at sunrise. In what order?</h2><ul id="dc-clues" style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:6px; line-height:1.4"></ul></div>
        <div id="dc-result" hidden></div>
        <div class="card stack" id="dc"><p class="coach">Loading the birds…</p></div>
      </div>
      <aside class="side"><div class="card stack"><h2 class="h-s">How to play</h2><p style="margin:0" class="muted">Every clue is true. Only one order fits them all. Place the birds you’re sure of first.</p></div></aside>
    </div>
  </main>
  <HelpDialog title="How to play Dawn Chorus"><ol class="steps"><li>Read the clues: each one is true.</li><li>Tap birds to place them on the branch in the order they sang; tap a bird on the branch to remove it.</li><li>When all five are placed, tap <b>Listen</b>. Only one order fits every clue.</li></ol></HelpDialog>
  <script>import '../scripts/dawn.ts';</script>
</Base>
