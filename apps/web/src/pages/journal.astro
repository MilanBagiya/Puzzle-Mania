---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { character } from '@wild-daily/ui';
---
<Base title="Forest Journal" description="Your collection of animal cards, one for every day you play." active="journal" noindex>
  <PageHead title="Forest Journal" />
  <main class="wrap body">
    <div class="game">
      <div class="stack">
        <div class="card row tight"><div style="flex:1; height:16px; border-radius:2px; background:var(--paper); box-shadow:inset 0 2px 0 var(--soft-e); overflow:hidden; min-width:160px"><div id="jr-bar" style="width:0; height:100%; background:var(--pine)"></div></div><b id="jr-count">0 of 12 found</b></div>
        <div class="card banner" id="jr-empty" style="background:var(--good)"><Fragment set:html={character('fox', 'idle', 80)} /><div class="grow"><h2 class="h-s">Your journal is empty</h2><p style="margin:4px 0 0" class="muted">Solve any puzzle to collect your first animal card. Each day you play adds one more.</p></div><a class="btn btn-p" href="/fresh-snow">Play today’s puzzle</a></div>
        <div class="grid4" id="jr-grid"></div>
      </div>
      <aside class="side" id="jr-side"></aside>
    </div>
  </main>
  <script>import '../scripts/journal.ts';</script>
</Base>
