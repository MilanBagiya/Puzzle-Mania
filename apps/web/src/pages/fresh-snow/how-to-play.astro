---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { character, drift } from '@wild-daily/ui';
const rules = [['Start at the edge', 'Each animal walked in from the edge of the snowfield.'], ['Move the animal’s way', 'Fox diagonally, rabbit hops 2, deer never turns back.'], ['Step on every one of its prints', 'All of an animal’s visible prints must be on its trail.'], ['Never step on another animal’s print', 'A visible square without that animal’s print is off its trail.'], ['Drifts hide prints', 'A snow drift could hide a print, or nothing at all.'], ['One animal per burrow', 'Every animal ends in its own burrow. Trails may cross.']];
---
<Base title="How to play Fresh Snow" description="Learn the rules of Fresh Snow in two minutes: how the fox, rabbit and deer move, the six rules, and tips for solving." active="howto">
  <PageHead title="How to play Fresh Snow" />
  <main class="wrap body">
    <section class="card" id="hx" style="display:grid; grid-template-columns:minmax(0,340px) minmax(0,1fr); gap:28px; align-items:start"><p class="coach">Loading the move explorer…</p></section>
    <style>@media (max-width:720px){#hx{grid-template-columns:1fr !important}}</style>
    <section class="section grid2" style="align-items:start">
      <div class="card stack"><h2 class="h-m">The six rules</h2><ol style="margin:0; padding-left:22px; display:flex; flex-direction:column; gap:10px; line-height:1.45">{rules.map(([t, d]) => <li><b>{t}.</b> <span class="muted">{d}</span></li>)}</ol></div>
      <div class="stack" style="gap:22px">
        <div class="card row" style="background:var(--good); flex-wrap:nowrap"><Fragment set:html={drift(90)} /><div><h3 class="h-s">Start with the clearest trail</h3><p style="margin:4px 0 0">Pick the animal with the most visible prints first. Its trail often leaves only one burrow for the others.</p></div></div>
        <div class="card row" style="background:var(--fox-t); flex-wrap:nowrap"><Fragment set:html={character('fox', 'oops', 84, 'shake')} /><div><h3 class="h-s">Stuck? Use a hint</h3><p style="margin:4px 0 0">Hint shows the next correct step. Tap any earlier step to go back to it.</p></div></div>
        <a class="btn btn-c big" href="/fresh-snow/tutorial">Take the 1-minute tutorial</a>
        <a class="btn btn-p big" href="/fresh-snow?level=morning">Play today’s Morning puzzle</a>
      </div>
    </section>
  </main>
  <script>import '../../scripts/howto.ts';</script>
</Base>
