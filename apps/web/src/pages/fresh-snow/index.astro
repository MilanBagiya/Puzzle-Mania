---
import Base from '../../layouts/Base.astro';
import { activeFor } from '../../data/catalog';
import { LEVELS, LEVEL_NAME } from '@wild-daily/core';
import { ANIMAL_NAME, ANIMAL_RULE, character, chevron, type AnimalId } from '@wild-daily/ui';
const animals: AnimalId[] = ['fox', 'rabbit', 'deer'];
const ld = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Fresh Snow', applicationCategory: 'GameApplication', operatingSystem: 'Any', url: new URL('/fresh-snow', Astro.site).href, description: 'A daily animal tracks puzzle: follow the footprints and guide every animal home.', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
---
<Base title="Fresh Snow: daily animal tracks puzzle" description="Read the footprints in fresh snow and guide every animal home. A new Morning, Noon and Night puzzle every day, free." active={activeFor('fresh-snow')} jsonLd={ld}>
  <main class="wrap" style="padding-top:18px">
    <div class="gamehead">
      <div class="row">
        <a class="btn btn-w" href="/" id="fs-back" style="min-height:44px; padding:0 12px"><Fragment set:html={chevron('left')} /><span class="sr">Back</span></a>
        <div><h1 class="h-l">Fresh Snow</h1><span class="muted" style="font-weight:800" id="fs-date">Today’s puzzle</span></div>
      </div>
      <div class="row" style="gap:8px"><span class="pill p-w timer" id="fs-timer" aria-label="Time">0:00</span><button class="btn btn-w iconbtn" data-act="help" aria-label="How to play"><b class="display" style="font-size:22px">?</b></button></div>
    </div>
    <div class="banner" id="fs-banner" hidden style="margin:6px 0 4px">
      <Fragment set:html={character('fox', 'idle', 60)} />
      <div class="grow"><b class="display" style="font-size:19px">First time playing?</b><div class="muted">Take the 1-minute guided tutorial, then come back to this puzzle.</div></div>
      <div class="row" style="gap:8px"><a class="btn btn-p" href="/fresh-snow/tutorial">Start tutorial</a><button class="btn btn-w" id="fs-skip">I know how</button></div>
    </div>
    <div class="game">
      <div class="stack">
        <nav class="tabs" id="fs-tabs" aria-label="Level">{LEVELS.map((l) => <a class="tab" data-level={l} href={`/fresh-snow?level=${l}`} style="display:grid; place-items:center; text-decoration:none">{LEVEL_NAME[l]}</a>)}</nav>
        <div id="fs-result" hidden></div>
        <div id="fs-game" class="stack"><p class="coach">Loading today’s snowfield…</p><noscript><p class="coach bad">Fresh Snow needs JavaScript to play.</p></noscript></div>
      </div>
      <aside class="side">
        <div class="card stack"><h2 class="h-s">How they move</h2>
          {animals.map((a) => <div class="row" style="flex-wrap:nowrap"><Fragment set:html={character(a, 'idle', 54, a === 'rabbit' ? 'boing' : '')} /><div><b class="display" style="font-size:18px">{ANIMAL_NAME[a]}</b><div class="muted" style="font-size:14px">{ANIMAL_RULE[a]}.</div></div></div>)}
          <p class="muted" style="margin:0; font-size:14px">Every visible print of an animal must be on its trail. Snow drifts hide prints. One animal per burrow.</p>
        </div>
        <div class="card stack"><h2 class="h-s">Stuck?</h2><p style="margin:0" class="muted">Hint shows the next correct step. Tap an earlier step on the board to go back to it.</p><a class="btn btn-w" href="/fresh-snow/tutorial">Replay the tutorial</a></div>
      </aside>
    </div>
  </main>
  <dialog id="helpdlg" aria-labelledby="helptitle"><div class="dlg">
    <div class="dlg-head"><h2 class="h-m" id="helptitle">How to play</h2><button class="btn btn-w iconbtn" data-act="closedlg" aria-label="Close">✕</button></div>
    <ol class="steps"><li><b>Pick an animal</b> card above the board.</li><li><b>Tap where its trail starts</b> on the edge. Glowing squares are the places it could go.</li><li><b>Keep tapping</b> one step at a time until it reaches a burrow.</li><li>Do the same for every animal, then tap <b>Check</b>.</li></ol>
    {animals.map((a) => <div class="kv"><Fragment set:html={character(a, 'idle', 48)} /><div><b>{ANIMAL_NAME[a]}</b> <span class="muted">{ANIMAL_RULE[a]}.</span></div></div>)}
    <p class="muted" style="margin:0">Every visible print must be on its animal’s trail, and no animal steps on a square showing only other prints. Drifts hide prints. One animal per burrow.</p>
    <div class="row"><a class="btn btn-w" href="/fresh-snow/tutorial">Take the tutorial</a><button class="btn btn-p" data-act="closedlg">Back to the puzzle</button></div>
  </div></dialog>
  <script>import '../../scripts/game.ts';</script>
</Base>
