---
import '@wild-daily/ui/styles.css';
import sprite from '@wild-daily/ui/sprite.svg?raw';
import castSprite from '@wild-daily/ui/cast.svg?raw';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SOUTH_TZ } from '@wild-daily/core';
// Fonts are self-hosted with the site (faster, and no visitor data sent to a font CDN).
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
// Preload the two Latin font files so text is drawn in its real font first (no re-wrap jump when fonts arrive).
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';
import atkinsonLatin from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
const southTz = SOUTH_TZ.source;
interface Props { title: string; description: string; active?: string; noindex?: boolean; /** @deprecated the cast is now on every page (card pictures use it). */ cast?: boolean; jsonLd?: Record<string, unknown> | Record<string, unknown>[] }
const { title, description, active = '', noindex = false, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonLatin} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} noindex={noindex} jsonLd={jsonLd} />
    <script is:inline define:vars={{ southTz }}>
      // Theme and season are set before the page draws, so there is no flash of the wrong look.
      (function () {
        var d = {}; try { d = JSON.parse(localStorage.getItem('wilddaily:v1') || '{}') || {}; } catch (e) {}
        var t = d.theme || 'auto'; if (t !== 'auto') document.documentElement.setAttribute('data-theme', t);
        var s = d.season || 'auto';
        if (['spring', 'summer', 'autumn', 'winter'].indexOf(s) < 0) {
          var h = d.hemisphere;
          if (h !== 'north' && h !== 'south') { var tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {} h = new RegExp(southTz).test(tz) ? 'south' : 'north'; }
          var m = new Date().getMonth(), n = m >= 2 && m <= 4 ? 'spring' : m >= 5 && m <= 7 ? 'summer' : m >= 8 && m <= 10 ? 'autumn' : 'winter';
          s = h === 'south' ? { spring: 'autumn', summer: 'winter', autumn: 'spring', winter: 'summer' }[n] : n;
        }
        document.documentElement.setAttribute('data-season', s);
        // A friend's challenge in the link: show its slot from the first paint (scripts/daily.ts fills it in).
        if (/[?&]vs=s[0-3]\.t\d/.test(location.search)) document.documentElement.setAttribute('data-vs', '');
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={sprite} />
    <Fragment set:html={castSprite} />
    <Header active={active} />
    <slot />
    <Footer />
    <script>
      import '../scripts/common.ts';
    </script>
  </body>
</html>
