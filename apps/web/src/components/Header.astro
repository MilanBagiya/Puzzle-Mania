---
import { character } from '@wild-daily/ui';
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  ['today', '/', 'Today'], ['games', '/games', 'Games'], ['trek', '/trek', 'Trail Trek'], ['archive', '/fresh-snow/archive', 'Archive'],
  ['guides', '/animals', 'Guides'], ['journal', '/journal', 'Journal'], ['stats', '/stats', 'Stats'],
] as const;
// Phone tab bar: the five places people go most. Archive and Guides stay one tap away on the Games page and footer.
const tabs = [
  ['today', '/', 'Today', 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'],
  ['games', '/games', 'Games', 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'],
  ['trek', '/trek', 'Trek', 'M5 21V4m0 0h11l-2 4 2 4H5'],
  ['journal', '/journal', 'Journal', 'M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11'],
  ['stats', '/stats', 'Stats', 'M5 20V11M12 20V5M19 20v-7'],
] as const;
---
<header class="top">
  <div class="wrap">
    <a class="logo" href="/"><Fragment set:html={character('fox', 'happy', 42)} /><span>Wild Daily</span></a>
    <nav class="nav" aria-label="Main">
      {links.map(([key, href, label]) => <a href={href} aria-current={key === active ? 'page' : undefined}>{label}</a>)}
    </nav>
    <button class="btn btn-w iconbtn" data-act="opts" aria-label="Options">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path></svg>
    </button>
  </div>
</header>
<nav class="tabbar" aria-label="Main">
  {tabs.map(([key, href, label, d]) => (
    <a href={href} aria-current={key === active ? 'page' : undefined}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d}></path></svg>
      <span>{label}</span>
    </a>
  ))}
</nav>
